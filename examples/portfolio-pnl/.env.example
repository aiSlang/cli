# portfolio-pnl — environment template.
#
# The default price sources (Yahoo Finance for equities/ETFs, CoinGecko for
# crypto) need NO API key, so the example runs out of the box.  Add
# keys here only if you switch a source adapter to a keyed provider.

# LLM provider used by the agents (via the resolved model catalog).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: only if you point the RAG/embedding step at OpenAI.
# OPENAI_API_KEY=

# Optional keyed price providers (defaults are key-free):
# ALPHAVANTAGE_API_KEY=
# COINGECKO_API_KEY=
