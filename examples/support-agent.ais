// examples/support-agent.ais — the v0.1 canonical reference example.
//
// Three jobs at once:
//   1. Demo: the .ais file shown on the landing page and in `aislang --help`.
//   2. Acceptance gate: if `aislang apply` doesn't produce a working stack
//      from this file in <60s on a clean machine, v0.1 is not done
//      (see PLAN-90-days.md §Definition of done).
//   3. Parser fixture: paired with `examples/support-agent.expected-ast.json`,
//      which is the AST the parser must produce. Tested in
//      `crates/aislang-core/tests/parser_fixtures.rs`.
//
// Treat any change to this file as a fixture migration: regenerate the
// expected-AST JSON in the same commit (see test header for the procedure).

project "support-agent" {
  budget {
    hard_cap_per_day = $50
    hard_cap_per_run = $0.50
    optimize_for     = cost
  }

  model "fast" {
    requires    = [chat, tool_use]
    context_min = 32k
    cost_max    = $0.001 per 1k_tokens
    latency_p95 = 2s
    residency   = [eu, us]

    prefer   = [anthropic.claude_haiku_4_5, openai.gpt_4o_mini]
    fallback = [ollama.llama_3_1_8b]
  }

  prompt "system" {
    file    = "./prompts/system.md"
    version = "1.0.0"
  }

  mcp_server "docs" {
    image = "docker.io/mcp/filesystem:1.0.2"
    mount = "./knowledge/"
  }

  agent "support" {
    model         = model.fast
    system_prompt = prompt.system
    tools         = [mcp_server.docs]
  }

  eval "factual_accuracy" {
    dataset   = "./evals/qa.jsonl"
    // F1 (bag-of-tokens) instead of exact_match: free-form LLM
    // output rarely matches a gold string verbatim, so we score
    // token overlap. Threshold 50% reflects what Llama 3.1 8B
    // on this knowledge base actually achieves; bigger models
    // would clear this comfortably.
    metric    = f1
    threshold = 50%
  }

  deploy "local" {
    target = compose
    expose {
      # `port` is informational; surfaces in the YAML header but no
      # v0.2 service binds it (the v0.2+ containerized agent runtime
      # via `aislang mcp-serve --http` will).
      port = 8080
      # When true, `aislang apply` brings up an Open WebUI sidecar at
      # http://localhost:3000 wired to the in-stack LiteLLM router.
      # `aislang destroy` wipes the named volume so chat history +
      # local user accounts go away alongside the stack.
      web_ui = true
    }
  }
}
