// examples/support-agent.ais — the v0.1 reference example.
//
// This file is the parser fixture and the demo on the landing page.
// If the v0.1 compiler can apply this file end-to-end on a clean
// machine in under 60 seconds, v0.1 ships.

project "support-agent" {
  budget {
    hard_cap_per_day = $50
    hard_cap_per_run = $0.50
    optimize_for     = cost
  }

  model "fast" {
    requires    = [chat, tool_use]
    context_min = 32k
    cost_max    = $0.001 per 1k_tokens
    latency_p95 = 2s
    residency   = [eu, us]

    prefer   = [anthropic.claude_haiku_4_5, openai.gpt_4o_mini]
    fallback = [ollama.llama_3_1_8b]
  }

  prompt "system" {
    file    = "./prompts/system.md"
    version = "1.0.0"
  }

  mcp_server "docs" {
    image = ghcr.io/example/mcp_filesystem:0.3.1
    mount = "./knowledge/"
  }

  agent "support" {
    model         = model.fast
    system_prompt = prompt.system
    tools         = [mcp_server.docs]
  }

  eval "factual_accuracy" {
    dataset   = "./evals/qa.jsonl"
    metric    = exact_match
    threshold = 85%
  }

  deploy "local" {
    target = compose
    expose = { port = 8080 }
  }
}
