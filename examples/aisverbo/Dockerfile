# aisVerbo on a HuggingFace Docker Space (free CPU tier, "Blank" template).
#
# IMPORTANT — Spaces have NO Docker daemon inside the container, so the
# aiSlang LiteLLM stack cannot come up via `aislang apply` (docker compose).
# Instead the proxy runs DIRECTLY as a process from the litellm_config.yaml
# that `aislang plan` generates. Ship these in the Space repo:
#   bin/aislang          a linux/amd64 `cargo build --release` of the
#                        aislang CLI, `strip`ped (a debug build is ~300 MB
#                        and HF needs git-lfs for it; release+strip is
#                        tens of MB — still track it with `git lfs track`)
#   litellm_config.yaml  generated by `aislang plan aisverbo.ais`
#   aislang.lock         ditto (prompt hashes — chat refuses without it)
#
# Space secrets:   ANTHROPIC_API_KEY, AISVERBO_SECRET
# Space variables: (optional) AISVERBO_DATA=/data with persistent storage —
#                  without it, tenant data resets on every restart.
# trixie, not bookworm: the aislang binary links glibc >= 2.39
FROM python:3.12-slim-trixie

RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH PORT=7860 HOST=0.0.0.0
WORKDIR /home/user/aisverbo

COPY --chown=user . .
RUN pip install --no-cache-dir --user -r requirements.txt "litellm[proxy]" \
 && if [ -f bin/aislang ]; then \
      mkdir -p /home/user/.local/bin && cp bin/aislang /home/user/.local/bin/ \
      && chmod +x /home/user/.local/bin/aislang; \
    fi

# hosted mode: per-visitor tenant partitions + the shared signing secret
# (mint your admin token with the same secret:
#  AISVERBO_SECRET=... python3 app/get_token.py)
ENV AISVERBO_MULTI_TENANT=1

# Newer LiteLLM refuses to boot without a master key. The aislang runtime
# client sends NO Authorization header (it is built for a keyless loopback
# proxy), so a master key would 401 every call. Keyless is safe in THIS
# topology: the proxy binds 127.0.0.1 inside the container and HuggingFace
# routes only port 7860 — :4000 is unreachable from outside.
ENV LITELLM_DANGEROUSLY_PERMIT_WEAK_OR_UNSET_MASTER_KEY=true

# the LiteLLM proxy (the aiSlang model router) + the web app, one container
CMD ["sh", "-c", "litellm --config litellm_config.yaml --host 127.0.0.1 --port 4000 & sleep 5 && python3 app/serve.py"]
