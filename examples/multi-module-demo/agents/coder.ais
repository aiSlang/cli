## v0.3 Week 16 Mon scaffold — see the sibling `aislang.toml`.
##
## Today this is a self-contained single-module .ais (carries its own
## outer `project { … }` block).  Week 16 Wed switches it to module-
## shape.

project "coder-module" {
  budget {
    hard_cap_per_day = $1
    hard_cap_per_run = $0.01
  }
  model "fast" {
    requires    = [chat]
    context_min = 32k
    prefer      = [ollama.llama_3_1_8b]
    pin         = ollama.llama_3_1_8b
  }
  prompt "system" {
    file    = "./system.md"
    version = "1.0.0"
  }
  agent "coder" {
    model         = model.fast
    system_prompt = prompt.system
    tools         = []
  }
}
