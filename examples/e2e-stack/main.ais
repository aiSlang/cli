// examples/e2e-stack/main.ais — self-contained K8s stack for the
// managed-cloud multi-tenant e2e (deploy/eks/40-e2e-two-tenants.sh).
//
// Named `main.ais` because the cloud repo-loader looks for `main.ais`
// (or `aislang.toml`) at the repo root / repo_path subdir.
//
// Deliberately minimal + SELF-CONTAINED (one .ais + one prompt file, no
// knowledge dir / eval dataset / mcp_server mounts) so it deploys cleanly
// from a fresh git clone.  Push this directory to two throwaway repos to
// drive the two-tenant isolation run (a repo is globally 1:1, so each
// tenant needs its own repo).

project "e2e-stack" {
  budget {
    hard_cap_per_day = $50
    hard_cap_per_run = $0.50
    optimize_for     = cost
  }

  model "fast" {
    requires    = [chat]
    context_min = 32k
    cost_max    = $0.001 per 1k_tokens
    latency_p95 = 2s
    residency   = [eu, us]
    // Anthropic first so the e2e chat exercise works with ANTHROPIC_API_KEY
    // (swap the order or set OPENAI_API_KEY to route to gpt-4o-mini).
    prefer   = [anthropic.claude_haiku_4_5, openai.gpt_4o_mini]
    fallback = [ollama.llama_3_1_8b]
  }

  prompt "system" {
    file    = "./prompts/system.md"
    version = "1.0.0"
  }

  agent "support" {
    model         = model.fast
    system_prompt = prompt.system
  }

  deploy "prod" {
    target = kubernetes
    expose {
      port = 8080
    }
  }
}
