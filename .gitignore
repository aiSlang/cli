# Rust
/target
**/*.rs.bk
*.pdb

# aiSlang local state
.aislang/

# Local skill caches (each dev's own running deltas — see
# .claude/skills/code-stat/SKILL.md). Committed skill files are
# tracked; their state files are not.
.claude/skills/*/cache.txt

# `aislang apply` writes stack.yml into the source dir; it embeds
# absolute host paths (litellm volume mount) so it's machine-specific
# — NOT for commit. Regenerate with `aislang plan` / `aislang apply`.
stack.yml

# Secrets / env
.env
.env.*
.secrets/
*.key
*.pem

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Allow lockfile (this is a binary crate — Cargo.lock should be committed)
!Cargo.lock
