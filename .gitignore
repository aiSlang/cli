# Rust
/target
**/*.rs.bk
*.pdb

# aiSlang local state
.aislang/

# `aislang apply` writes stack.yml into the source dir; it embeds
# absolute host paths (litellm volume mount) so it's machine-specific
# — NOT for commit. Regenerate with `aislang plan` / `aislang apply`.
stack.yml

# Secrets / env
.env
.env.*
.secrets/
*.key
*.pem

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Allow lockfile (this is a binary crate — Cargo.lock should be committed)
!Cargo.lock
